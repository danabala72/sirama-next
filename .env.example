# Gunakan salinan database untuk staging. Jangan arahkan ke database produksi.
# URL-encode password jika mengandung @, #, /, :, %, atau karakter khusus lain.
DATABASE_URL="mysql://sirama_staging_user:GANTI_PASSWORD@127.0.0.1:3306/sirama_staging"

# Buat nilai baru dengan: openssl rand -base64 48
SESSION_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

NODE_ENV="production"
